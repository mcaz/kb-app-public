{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcaz/kb-app/schemas/retrieval-eval.schema.json",
  "title": "kb-app retrieval Golden Query suite",
  "description": "Local-only surface matrix for comparing top3 with linked_v1 (and delivery profiles) and gating selected document bodies. 2.1.0 adds the optional routine surface, per-case gate_mode and family; 2.0.0 suites stay frozen in the classic form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "enum": ["2.0.0", "2.1.0"] },
    "stability_runs": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "if": { "properties": { "schema_version": { "const": "2.0.0" } } },
  "then": {
    "properties": {
      "cases": {
        "items": {
          "properties": {
            "family": false,
            "gate_mode": false,
            "queries": { "properties": { "routine": false } }
          }
        }
      }
    }
  },
  "$defs": {
    "trimmed_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" }
    },
    "body_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
        "all_terms": { "$ref": "#/$defs/trimmed_strings" },
        "any_terms": { "$ref": "#/$defs/trimmed_strings" }
      },
      "anyOf": [
        { "required": ["all_terms"], "properties": { "all_terms": { "minItems": 1 } } },
        { "required": ["any_terms"], "properties": { "any_terms": { "minItems": 1 } } }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "queries", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
        "family": {
          "description": "2.1.0 only. Name of the hypothesis group this case belongs to; reports aggregate family × strategy.",
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "queries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codex", "claude_code", "chatgpt"],
          "properties": {
            "codex": { "type": "string", "minLength": 1 },
            "claude_code": { "type": "string", "minLength": 1 },
            "chatgpt": { "type": "string", "minLength": 1 },
            "routine": {
              "description": "2.1.0 only. Optional fourth surface imitating a templated routine prompt.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": { "$ref": "#/$defs/trimmed_strings", "minItems": 1 },
        "relevant": { "$ref": "#/$defs/trimmed_strings" },
        "excluded": { "$ref": "#/$defs/trimmed_strings" },
        "body_requirements": { "type": "array", "items": { "$ref": "#/$defs/body_requirement" } },
        "gate_mode": {
          "description": "2.1.0 only. `selected` (default) requires every required note body to be selected; `candidates` only requires every required note to enter the candidate set, and reports body requirements without gating on them.",
          "enum": ["selected", "candidates"],
          "default": "selected"
        }
      }
    }
  }
}
