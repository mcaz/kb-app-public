{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcaz/kb-app/schemas/retrieval-eval.schema.json",
  "title": "kb-app retrieval Golden Query suite",
  "description": "Local-only cases for comparing the evaluation-only top3 baseline with linked_v1 retrieval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "note_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "$ref": "#/$defs/note_ids",
          "minItems": 1,
          "description": "Notes required as answer evidence. They are also considered relevant for precision."
        },
        "relevant": {
          "$ref": "#/$defs/note_ids",
          "description": "Additional acceptable notes. Do not repeat required IDs."
        },
        "excluded": {
          "$ref": "#/$defs/note_ids",
          "description": "Notes whose selection is an explicit violation."
        }
      }
    }
  }
}
