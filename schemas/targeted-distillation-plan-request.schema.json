{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb-app.local/schemas/targeted-distillation-plan-request.schema.json",
  "title": "kb-app targeted distillation plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["changes"],
  "properties": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "operation", "reason"],
        "properties": {
          "note": {"type": "string", "minLength": 1},
          "operation": {"enum": ["normalize", "revise", "extract"]},
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  }
}
