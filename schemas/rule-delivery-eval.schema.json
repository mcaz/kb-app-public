{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcaz/kb-app/schemas/rule-delivery-eval.schema.json",
  "title": "kb-app Rule Delivery Matrix evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules", "notes", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tag_vocabulary_source": {"type": ["string", "null"], "minLength": 1, "description": "fixtureで明示指定するnotes内のexpected_id。省略時は自動選択しない。"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "notes": {
      "type": "array",
      "items": {"$ref": "#/$defs/note"}
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "instruction", "triggers", "event_tools", "broken", "conflict_group"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scope": {"enum": ["always", "topic", "event", "config"]},
        "instruction": {"type": "string", "minLength": 1},
        "triggers": {"$ref": "#/$defs/strings"},
        "event_tools": {"$ref": "#/$defs/strings"},
        "broken": {"type": "boolean"},
        "conflict_group": {"type": ["string", "null"]}
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_id", "title", "body", "tags"],
      "properties": {
        "expected_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string"},
        "tags": {"$ref": "#/$defs/strings", "minItems": 1, "maxItems": 4}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "prompt", "relevant_rule_ids", "injected_degradations", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[ATEC][1-5]$"},
        "category": {"enum": ["always", "topic", "event", "control"]},
        "prompt": {"type": "string", "minLength": 1},
        "relevant_rule_ids": {"$ref": "#/$defs/strings"},
        "injected_degradations": {"$ref": "#/$defs/strings"},
        "expected": {"$ref": "#/$defs/expectation"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_tools": {"$ref": "#/$defs/strings"},
        "forbidden_tools": {"$ref": "#/$defs/strings"},
        "required_note_ids": {"$ref": "#/$defs/strings"},
        "response_must_include": {"$ref": "#/$defs/strings"},
        "response_must_not_include": {"$ref": "#/$defs/strings"},
        "pre_tool_must_include": {"$ref": "#/$defs/strings"},
        "required_write_tags": {"$ref": "#/$defs/strings"},
        "forbidden_write_tags": {"$ref": "#/$defs/strings"},
        "required_conversation_links": {"type": "integer", "minimum": 0},
        "required_conversation_events": {"$ref": "#/$defs/strings"},
        "required_conversation_events": {"$ref": "#/$defs/strings"},
        "require_artifact_identity": {"type": "boolean"},
        "require_degraded": {"type": "boolean"},
        "skip_kb_tools": {"type": "boolean"}
      }
    }
  }
}
