{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcaz/kb-app/schemas/retrieval-benchmark.schema.json",
  "title": "kb-app synthetic retrieval benchmark suite",
  "description": "An isolated synthetic corpus with regression controls and diagnostic retrieval challenges.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notes", "controls", "challenges"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/note" }
    },
    "controls": { "$ref": "retrieval-eval.schema.json" },
    "challenges": { "$ref": "retrieval-eval.schema.json" }
  },
  "$defs": {
    "trimmed_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "role", "status", "scope"],
      "properties": {
        "namespace": {
          "enum": ["entities", "initiatives", "decisions", "procedures", "records", "knowledge"]
        },
        "role": { "enum": ["canonical", "record", "proposal"] },
        "status": { "enum": ["active", "historical", "superseded"] },
        "scope": { "$ref": "#/$defs/trimmed_string" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": {
          "enum": ["derived_from", "supports", "updates", "contradicts", "supersedes", "mentions"]
        },
        "target_id": { "$ref": "#/$defs/trimmed_string" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_id", "title", "description", "body", "tags", "authority"],
      "properties": {
        "expected_id": { "$ref": "#/$defs/trimmed_string" },
        "title": { "$ref": "#/$defs/trimmed_string" },
        "description": {
          "oneOf": [
            { "$ref": "#/$defs/trimmed_string" },
            { "type": "null" }
          ]
        },
        "body": { "type": "string" },
        "body_repetitions": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 1 },
        "tags": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trimmed_string" }
        },
        "authority": { "$ref": "#/$defs/authority" },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    }
  }
}
