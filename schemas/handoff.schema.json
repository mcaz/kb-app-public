{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcaz/kb-app/schemas/handoff.schema.json",
  "title": "kb-app development handoff",
  "description": "Short-lived intent for another development agent. Git remains the source of current facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "next",
    "discarded",
    "open_questions",
    "branch",
    "base_commit",
    "created_at",
    "updated_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discarded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "branch": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "base_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "issue_url"],
      "properties": {
        "provider": {
          "const": "github"
        },
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
