{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb-app.local/schemas/distillation-execution.schema.json",
  "title": "kb-app semantic distillation execution request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_schema",
    "planner_profile",
    "plan_id",
    "snapshot_digest",
    "snapshot_note_count",
    "changes"
  ],
  "properties": {
    "schema": { "const": "kb-app.distillation-execution-request/v1" },
    "plan_schema": { "const": "kb-app.distillation-plan/v1" },
    "planner_profile": { "const": "mechanical-v1" },
    "plan_id": { "$ref": "#/$defs/hash" },
    "snapshot_digest": { "$ref": "#/$defs/hash" },
    "snapshot_note_count": { "type": "integer", "minimum": 0 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": [
            "derived_from",
            "supports",
            "updates",
            "contradicts",
            "supersedes",
            "mentions"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "description", "tags", "relations"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "body": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "input_hash", "operation", "reason", "target"],
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "input_hash": { "$ref": "#/$defs/hash" },
        "operation": { "enum": ["normalize", "revise", "extract"] },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n]+$"
        },
        "target": { "$ref": "#/$defs/target" }
      }
    }
  }
}
