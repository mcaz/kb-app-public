{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcaz/kb-app/schemas/checks.schema.json",
  "title": "kb-app development checks",
  "description": "Validation evidence bound to an exact Git worktree state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_for",
    "recorded_at",
    "scope",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "recorded_for": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "base_commit", "state_stamp"],
      "properties": {
        "branch": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "base_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "state_stamp": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "enum": ["full", "partial", "unknown"]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
